# Copy this file to a new file named .env and fill in your own values.
# .env stays on your computer and is never uploaded to GitHub.

# From elevenlabs.io: your profile › API Keys
ELEVENLABS_API_KEY=

# The voice to use. In ElevenLabs, open a voice and copy its Voice ID.
ELEVENLABS_VOICE_ID=

# Optional. Leave blank for the default (eleven_multilingual_v2).
ELEVENLABS_MODEL=
